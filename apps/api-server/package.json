{
  "name": "@ant-captcha/api-server",
  "version": "0.1.0",
  "private": true,
  "description": "Ant-Captcha 打码平台服务（HTTP API + Cordis 编排）",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "start": "node dist/main.js",
    "test": "node --test --experimental-strip-types --test-isolation=none tests/solve.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  }
}
